  "selected": 1,
  "note": "Original Soviet-style copy proposals; not historical quotations.",
  "items": [
    {
      "id": 1,
      "lines": [
        "Хорошая стрижка",
        "— дело чести!"
      ]
    },
    {
      "id": 2,
      "lines": [
        "За дело — с душой.",
        "За стрижку — по совести."
      ]
    },
    {
      "id": 3,
      "lines": [
        "Товарищ,",
        "доверься мастеру!"
      ]
    },
    {
      "id": 4,
      "lines": [
        "Честный труд.",
        "Твой новый образ."
      ]
    },
    {
      "id": 5,
      "lines": [
        "Стрижём на совесть.",
        "Встречаем по-доброму."
      ]
    },
    {
      "id": 6,
      "lines": [
        "Мастерство — в дело.",
        "Сомнения — в сторону!"
      ]
    },
    {
      "id": 7,
      "lines": [
        "Каждому товарищу",
        "— достойную стрижку!"
      ]
    },
    {
      "id": 8,
      "lines": [
        "Новый мастер",
        "— добрый почин!"
      ]
    },
    {
      "id": 9,
      "lines": [
        "Мастерству",
        "— дорогу!"
      ]
    },
    {
      "id": 10,
      "lines": [
        "Встречай мастера.",
        "Оценивай по делу!"
      ]
    }
  ]
}
