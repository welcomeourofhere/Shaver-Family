---
import Headline from './Headline.astro';
import site from '../../content/site.json';
const cards = [
  { image: 'certificate-front', label: 'Лицевая сторона подарочного сертификата', value: 'front' },
  { image: 'certificate-1000', label: 'Подарочный сертификат на 1 000 рублей', value: '1000' },
  { image: 'certificate-back', label: 'Подарочный сертификат на 2 000 рублей', value: '2000' },
  { image: 'certificate-3000', label: 'Подарочный сертификат на 3 000 рублей', value: '3000' },
];
---
<section class="certificates" data-selection-surface="blue" id="certificates" aria-labelledby="certificate-title">
  <div class="certificate-scene" data-certificate-scene aria-label="Рассмотреть подарочные карты">
    <div class="certificate-stack">
      {cards.map((card, index) => <button class={`certificate-object ${index === 0 ? 'certificate-front' : 'certificate-back'}`} style={`--certificate-index:${index}`} type="button" data-certificate data-certificate-value={card.value} aria-pressed="false" aria-label={`Выдвинуть: ${card.label.toLowerCase()}`}><span class="certificate-art" data-loading-media><img src={`/reference/${card.image}.webp`} width="900" height="1422" alt={card.label} loading="lazy" /></span></button>)}
    </div>
  </div>
  <div class="certificate-copy">
    <Headline id="certificate-title" name="certificate" />
  </div>
  <p class="certificate-description">Подари время для себя к празднику или просто так. Владелец сертификата сам выберет стрижку и уход в СОЮЗе.</p>
  <a class="btn btn-cream certificate-buy" href={site.certificateUrl} target="_blank" rel="noopener noreferrer" data-booking data-booking-form="certificate" data-booking-url={site.certificateUrl} data-context="Подарочный сертификат СОЮЗа">Приобрести</a>
</section>
