---
import Headline from './Headline.astro';
import ContactChannels from './ContactChannels.astro';
import site from '../../content/site.json';
import BusinessHours from './BusinessHours.astro';
import contacts from '../../content/contacts.json';
import {contactMap,contactMapEmbed} from '../content/contact-map';
import '../styles/contacts.css';
import {bookingURLs} from '../scripts/booking-url';
const bookingHref=bookingURLs(site.bookingUrl)!.publicUrl;
const map=contactMap.source;
const embed=contactMapEmbed;
const futureMap=`https://yandex.ru/maps/?text=${encodeURIComponent(`${site.city}, ${site.futureAddress}`)}`;
---
<section class="section shell contact-section" id="contacts" aria-labelledby="contacts-title">
 <Headline class="section-title" id="contacts-title" name="contacts" />
 <div class="contact-layout">
  <div class="contact-map" data-loading-component data-map-state="idle" data-map-provider="yandex">
   <iframe id="contacts-map-frame" title={`Яндекс Карты — СОЮЗ, ${site.city}, ${site.address}`} data-map-src={embed} aria-hidden="true" tabindex="-1" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
   <div class="contact-map-fallback" hidden role="status"><p>Карта временно недоступна.</p><a class="btn btn-cream" href={map} target="_blank" rel="noopener noreferrer">Яндекс Карты</a></div>
   <noscript><iframe title={`Яндекс Карты — СОЮЗ, ${site.city}, ${site.address}`} src={embed} loading="lazy" aria-hidden="true" tabindex="-1" referrerpolicy="strict-origin-when-cross-origin"></iframe></noscript>
   <a class="contact-map-credit" href={map} target="_blank" rel="noopener noreferrer">СОЮЗ в Яндекс Картах</a>
  </div>
  <div class="contact-stack">
   <article class="contact-card contact-visit" data-selection-surface="red" data-surface="dark" aria-labelledby="contact-address-title">
    <h3 id="contact-address-title">СОЮЗ</h3>
    <dl class="contact-business-lines">
     <div><dt>Режим работы:</dt>{' '}<dd>ежедневно, <BusinessHours /></dd></div>
     <div><dt>Адрес:</dt>{' '}<dd><a class="contact-address" href={map} target="_blank" rel="noopener noreferrer">{site.city}, {site.address}</a><span class="contact-future">(скоро: <a href={futureMap} target="_blank" rel="noopener noreferrer">{site.futureAddress}</a>)</span></dd></div>
     <div><dt>Телефон:</dt>{' '}<dd><a class="contact-phone" href={`tel:${site.phoneLink}`}>{site.phone}</a></dd></div>
    </dl>
    <div class="contact-actions"><a class="btn" href={bookingHref} data-booking aria-haspopup="dialog" aria-controls="booking-drawer" aria-label="Записаться онлайн">Записаться</a><ContactChannels compact iconsOnly showPhone={false} /></div>
   </article>
   {contacts.people.map(person=>{const [first,...surname]=person.name.split(' ');return <article class="contact-card contact-person" data-contact-person={person.id} data-selection-surface={person.tone}><div class="contact-portrait" data-loading-media><img src={person.image} alt={person.name} width={person.width} height={person.height} loading="lazy" decoding="async" draggable="false" /></div><div class="contact-person-copy"><h3 aria-label={person.name}><span>{first}</span><span>{surname.join(' ')}</span></h3><p>{person.role}</p><div class="contact-person-links"><a href={`tel:${person.phoneTel}`} aria-label={person.phoneDisplay} title={person.phoneDisplay} data-action-short="Тел." data-action-bleed><span data-action-label>{person.phoneDisplay}</span></a><a href={person.telegramUrl} aria-label={person.telegram} title={person.telegram} data-action-short="TG" data-action-bleed target="_blank" rel="noopener noreferrer"><span data-action-label>{person.telegram}</span></a></div></div></article>})}
  </div>
 </div>
</section>
<script>import '../scripts/action-label';import '../scripts/contact-map';</script>
