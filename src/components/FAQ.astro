---
import content from '../../content/faq.json';
import site from '../../content/site.json';
import catalogue from '../../content/service-catalog.json';
import '../styles/faq.css';
import Headline from './Headline.astro';
import LinkedText from './LinkedText.astro';

const services=catalogue.categories.flatMap(category=>category.services);
const service=(id:string)=>{const item=services.find(item=>item.id===id);if(!item)throw new Error(`Missing FAQ service ${id}`);return item;};
const haircut=service('main-267602'),child=service('main-267628'),beard=service('hair-beard-267631'),complex=service('main-267630');
const facts:Record<string,string>={address:site.address,hours:site.hours,phone:site.phone,firstVisitPercent:String(site.firstVisitPercent),promo:site.promo,cashbackPercent:String(site.cashbackPercent),haircutPrice:haircut.priceLabel,haircutDuration:haircut.duration,childPrice:child.priceLabel,childDuration:child.duration,beardPrice:beard.priceLabel,beardDuration:beard.duration,complexPrice:complex.priceLabel};
const format=(text:string)=>text.replace(/\{(\w+)\}/g,(_,key:string)=>{if(!(key in facts))throw new Error(`Unknown FAQ fact ${key}`);return facts[key];});
---

<section class="section shell faq-section" id="faq" aria-labelledby="faq-title">
  <div class="faq-layout">
    <Headline class="section-title faq-title" id="faq-title" name="faq" aside />
    <div class="faq-list">
      {content.items.map((item,index) => (
        <details class="faq-item" name="soyuz-faq" id={`faq-${item.id}`} data-faq-tone={['red','blue','ink'][index%3]} data-selection-surface={['red','blue','ink'][index%3]} data-faq-rest={index>=5?true:undefined} hidden={index>=5}>
          <summary aria-label={`${item.mobileLabel}. ${item.question}`}><span class="faq-question-full">{item.question}</span><span class="faq-question-short">{item.mobileLabel}</span><span class="faq-mark" aria-hidden="true"></span></summary>
          <div class="faq-answer">{item.answer.map((paragraph) => <p><LinkedText text={format(paragraph)} /></p>)}</div>
        </details>
      ))}
      <button class="btn faq-more" type="button" data-faq-more aria-expanded="false" aria-label="Показать остальные вопросы">Ещё вопросы</button>
    </div>
  </div>
</section>
<script>import '../scripts/faq';</script>
