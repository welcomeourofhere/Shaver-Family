---
import catalog from '../../content/offers.json';
import team from '../../content/team.json';
import artwork from '../../content/fair-price-artwork.json';
import slogans from '../../content/honest-price-slogans.json';
import '../styles/first-visit.css';
import Headline from './Headline.astro';
const offer = catalog.offers.find(item => item.id === 'honest-price')!;
const masters = (offer.eligibleMasterIds || []).map(id => team.masters.find(master => master.id === id)!);
const slogan = slogans.items.find(item => item.id === slogans.selected)!;
const figures = artwork.separateFigures.items;
---
<section class="section shell visit-section" id="first-visit" aria-labelledby="visit-title">
  <Headline class="section-title" id="visit-title" name="fair" lines={slogan.lines} />
  <div class="visit-ticket" data-selection-surface="red">
    <div class="visit-surface" aria-hidden="true"><div class="visit-print"><div class="visit-rays soyuz-rays"></div></div></div>
    <div class="visit-copy">
      <h3>{(offer.titleLines??[offer.title]).map((line,index)=><>{index>0&&<br />}{line}</>)}</h3>
      <p aria-describedby="fair-terms"><span>Приходи на первый<span class="yellow-mark" aria-hidden="true">*</span> визит к Соне Кид или Свете. В услугу входят мужская стрижка, мытьё головы и укладка. Оцени результат и заплати любую сумму от {offer.minimumPrice} ₽.</span></p>
      <div class="visit-actions">
        {masters.map(master => <button class="btn" type="button" data-booking data-booking-url={master.bookingUrl} data-master={master.id} data-context={`Честная цена от ${offer.minimumPrice} ₽: ${master.id === 'souz-sonya-kid' ? 'Соня' : 'Света'}`} aria-label={`Записаться по акции «Честная цена» к ${master.id === 'souz-sonya-kid' ? 'Соне' : 'Свете'}`}><span class="visit-book-long">{master.id === 'souz-sonya-kid' ? 'Записаться к Соне' : 'Записаться к Свете'}</span><span class="visit-book-short">{master.id === 'souz-sonya-kid' ? 'К Соне' : 'К Свете'}</span></button>)}
        <small id="fair-terms"><span class="yellow-mark" aria-hidden="true">*</span> На первый визит именно к выбранному мастеру.</small>
      </div>
    </div>
    <div class="visit-art" data-loading-media>
      <div class="visit-figures">{figures.map(figure=><img class={`visit-figure visit-${figure.id}`} src={figure.url} width={figure.size[0]} height={figure.size[1]} alt={figure.id==='sonya'?'Соня Кид — барбер СОЮЗа, иллюстрация для акции «Честная цена»':'Света — барбер СОЮЗа, иллюстрация для акции «Честная цена»'} loading="lazy" decoding="async" />)}</div>
    </div>
  </div>
</section>
