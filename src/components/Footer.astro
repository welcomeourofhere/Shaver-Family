---
import site from '../../content/site.json';
import BusinessHours from './BusinessHours.astro';
import '../styles/footer.css';
import {footerNavigation} from '../config/navigation';
import legal from '../../content/legal/pages.json';
import operator from '../../content/legal/operator.json';
import {bookingURLs} from '../scripts/booking-url';
const bookingHref=bookingURLs(site.bookingUrl)!.publicUrl;
const popularSections=['services','masters','works','offers','contacts'];
const links=footerNavigation.filter(link=>popularSections.includes(link.id));
const contacts=[
  {label:site.phone,url:`tel:${site.phoneLink}`,id:'phone'},
  {label:'Онлайн-запись',url:bookingHref,id:'booking'},
  {label:'Telegram',url:site.telegram,id:'telegram'},
  {label:'MAX',url:site.maxUrl,id:'max'},
  {label:'ВКонтакте',url:site.vkMessageUrl,id:'vk'},
];
const {homeHref=''}=Astro.props;
---
<footer data-selection-surface="ink" class="footer shell" id="footer"><div class="footer-card">
  <div class="footer-panel">
    <div class="footer-summary">
      <a class="footer-logo" href={`${homeHref}#top`} aria-label="СОЮЗ — главная"><span class="footer-brand-mark" aria-hidden="true"></span></a>
      <p class="footer-description">Первый барбершоп в Кирове, где стригут и бреют только девушки.</p>
      <p class="footer-address">{site.city}, {site.address}</p>
      <div class="footer-hours"><span>Ежедневно</span><BusinessHours /></div>
    </div>
    <div class="footer-directory">
      <nav class="footer-group footer-navigation" aria-labelledby="footer-navigation-title">
        <h2 class="footer-heading" id="footer-navigation-title">Навигация</h2>
        <div class="footer-links footer-groups">{links.map(link=><a href={`${homeHref}#${link.id}`}>{link.label}</a>)}</div>
      </nav>
      <nav class="footer-group footer-contacts" aria-labelledby="footer-contacts-title">
        <h2 class="footer-heading" id="footer-contacts-title">Связаться</h2>
        <div class="footer-links footer-contact-links">{contacts.map(contact=><a href={contact.url} target={contact.id==='phone'||contact.id==='booking'?undefined:'_blank'} rel={contact.id==='phone'||contact.id==='booking'?undefined:'noopener noreferrer'} data-contact-channel={contact.id==='booking'?undefined:contact.id} data-booking={contact.id==='booking'||undefined} aria-haspopup={contact.id==='booking'?'dialog':undefined} aria-controls={contact.id==='booking'?'booking-drawer':undefined}>{contact.label}</a>)}</div>
      </nav>
      <nav class="footer-group footer-documents" aria-labelledby="footer-documents-title">
        <h2 class="footer-heading" id="footer-documents-title">Документы</h2>
        <div class="footer-links footer-legal">{legal.pages.map(page=><a href={`/${page.slug}/`}>{page.title}</a>)}</div>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <p class="footer-copyright">© {new Date().getFullYear()} СОЮЗ Барбершоп</p>
    <p class="footer-identity"><span>{operator.legalName}</span> · <span>ИНН {operator.inn}</span> · <span>ОГРНИП {operator.ogrnip}</span></p>
  </div>
</div></footer>
