---
import Icon from './Icon.astro';
import catalog from '../../content/offers.json';
import posters from '../../content/offer-poster-sources.json';
import design from '../config/design.json';
import '../styles/offers.css';
import Headline from './Headline.astro';
import RailControls from './RailControls.astro';
import InfoTip from './InfoTip.astro';
import site from '../../content/site.json';
import {bookingURLs} from '../scripts/booking-url';
const bookingHref=bookingURLs(site.bookingUrl)!.publicUrl;

const { offers } = catalog;
const tones = design.offerThemes.base;
const colorStyle = (index: number) => {
  const tone = tones[index];
  const foreground = (tone: string) => tone === 'yellow' ? 'ink' : 'paper';
  const button = tone === 'yellow' ? 'ink' : 'yellow';
  const values = {bg: tone, fg: foreground(tone), 'button-bg': button, 'button-fg': foreground(button), 'button-hover-bg': tone === 'blue' ? 'red' : 'blue', 'button-hover-fg': 'paper'};
  return Object.entries(values).map(([key, value]) => `--offer-base-${key}:var(--${value})`).join(';')+`;--offer-order:${index}`;
};
const posterById = Object.fromEntries(posters.images.map(image => [image.id, image]));
const imageURL = (variant: {url: string; sha256: string}) => `${variant.url}?v=${variant.sha256.slice(0, 12)}`;
const blankPoster='data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"/>');
const posterSizes="(max-width:390px) calc(100vw - 40px), (max-width:544px) 350px, (max-width:1000px) 300px, (max-width:1167px) 30vw, 350px";
---

<section class="section of-section" id="offers" aria-labelledby="offers-title" data-offers>
  <div class="shell of-layout">
    <div class="of-intro">
      <Headline class="section-title of-heading" id="offers-title" name="offers" aside />
      <div class="of-controls" role="group" aria-label="Перелистывание акций">
        <button class="icon-btn of-arrow" type="button" data-ui-kind="selection" data-feedback="manual" data-of-prev aria-controls="offers-rail" aria-label="Предыдущая акция"><Icon name="left" /></button>
        <p class="of-position" data-of-position aria-live="polite" aria-atomic="true">1 / {offers.length}</p>
        <button class="icon-btn of-arrow" type="button" data-ui-kind="selection" data-feedback="manual" data-of-next aria-controls="offers-rail" aria-label="Следующая акция"><Icon name="right" /></button>
      </div>
    </div>

  <div class="of-slider">
  <p class="sr-only" id="offers-instructions">Листайте акции стрелками или проведите по карточкам. Клавиши влево и вправо переключают акции.</p>
  <div class="of-rail compact-rail" id="offers-rail" tabindex="0" role="region" aria-roledescription="карусель" aria-label="Все акции СОЮЗа" aria-describedby="offers-instructions" data-of-rail data-loop-ready data-rail-index="0" style={`--rail-count:${offers.length}`}>
    {offers.map((offer, index) => {const Action=offer.actionType==='booking'?'a':'button';return (
      <article
        class="of-card" style={colorStyle(index)} data-offer-active={index === 0 ? 'true' : 'false'}
        data-offer-tone={tones[index]} data-selection-surface={tones[index]}
        id={`offer-${offer.id}`}
        data-offer-id={offer.id}
        aria-roledescription="карточка акции"
        aria-label={`${index + 1} из ${offers.length}: ${offer.title}`}
      >
        {offer.note&&<div class="of-note"><InfoTip label={`Важно об акции «${offer.title.replace(/^Акция:\s*/u,'')}»`} text={offer.note} compact /></div>}
        <div class="of-photo photo-frame" data-loading-media aria-hidden="true"><img class="photo-image" src={index<2?imageURL(posterById[offer.id].variants[0]):blankPoster} srcset={index<2?posterById[offer.id].variants.map(variant => `${imageURL(variant)} ${variant.width}w`).join(', '):undefined} data-offer-src={index>=2?imageURL(posterById[offer.id].variants[0]):undefined} data-offer-srcset={index>=2?posterById[offer.id].variants.map(variant => `${imageURL(variant)} ${variant.width}w`).join(', '):undefined} sizes={index<2?posterSizes:undefined} data-offer-sizes={index>=2?posterSizes:undefined} width={posterById[offer.id].variants[1].width} height={posterById[offer.id].variants[1].height} alt="" loading="lazy" decoding="async" />{index>=2&&<noscript><img class="photo-image" src={imageURL(posterById[offer.id].variants[0])} srcset={posterById[offer.id].variants.map(variant => `${imageURL(variant)} ${variant.width}w`).join(', ')} sizes={posterSizes} width={posterById[offer.id].variants[1].width} height={posterById[offer.id].variants[1].height} alt="" loading="lazy" /></noscript>}</div>
        <div class="of-card-copy">
        <h3 class="of-title" id={`offer-title-${offer.id}`}>{offer.titleLines ? offer.titleLines.map((line, index) => <span>{line}{index < offer.titleLines.length - 1 ? ' ' : ''}</span>) : offer.title}</h3>
        <p class="of-summary">{offer.summary}</p>
          {offer.id === 'honest-price' ? <a class="btn of-action" href="#first-visit">{offer.action}</a> : offer.actionType==='vk'?<a class="btn of-action" href={site.vk} target="_blank" rel="noopener noreferrer" aria-label={offer.action}><span class="mobile-action-full">{offer.action}</span><span class="mobile-action-short">Промокод</span></a>:<Action
            class="btn of-action"
            type={offer.actionType==='booking'?undefined:'button'}
            href={offer.actionType==='booking'?bookingHref:undefined}
            data-ui-kind="filled"
            data-booking={offer.actionType === 'booking' ? true : undefined}
            data-contact={offer.actionType === 'contact' ? true : undefined}
            data-open-reviews={offer.actionType === 'review' ? true : undefined}
            aria-haspopup={offer.actionType === 'review'||offer.actionType === 'booking' ? 'dialog' : undefined}
            aria-controls={offer.actionType === 'review' ? 'review-dialog' : offer.actionType === 'booking'?'booking-drawer':undefined}
            data-context={`Акция: ${offer.title.replace(/^Акция:\s*/u, '')}`}
            aria-label={offer.action}
          >{offer.actionType === 'booking' || offer.id === 'referral' ? <><span class="mobile-action-full">{offer.action}</span><span class="mobile-action-short">{offer.actionType === 'booking' ? 'Записаться' : 'Подробнее'}</span></> : offer.action}</Action>}
        </div>
      </article>
    )})}
  </div>
  <RailControls id="offers-rail" count={offers.length} label="Перелистывание акций" />
  </div>
  </div>

</section>

<script>
  import '../scripts/offers';
</script>
