---
import {workSequence as photos,worksSourceStatus,workFilterMasters} from '../content/works';
import {workOffset,workDepth,workTilt} from '../scripts/works-layout';
import Headline from './Headline.astro';
import Icon from './Icon.astro';
import '../styles/works.css';
import '../styles/service-deck.css';
const first=photos[0],depth=workDepth(photos.length,4);
const masters=[{id:'all',name:'Все мастера'},...workFilterMasters];
const tabTones=['red','blue','yellow'];
const captionTitles=[...new Set(photos.map(photo=>photo.caption))],captionMasters=[...new Set(photos.map(photo=>photo.masterName))];
if(String(import.meta.env.SOYUZ_RELEASE)==='1'&&String(worksSourceStatus)!=='verified-combined')throw new Error('SOYUZ release requires verified combined work photographs; Works source is still '+worksSourceStatus);
---
<section class="section shell works" id="works" aria-labelledby="works-title" data-works data-works-source={worksSourceStatus} style={`--works-available-depth:${depth};--works-total:${photos.length}`}>
 <Headline class="section-title" name="works" id="works-title" />
 <div class="sd-tabs works-master-tabs" role="tablist" aria-label="Работы мастеров" data-work-tabs data-feedback="manual">
  {masters.map((master,index)=><button class="sd-tab" id={`works-master-${master.id}`} type="button" role="tab" aria-label={master.name} aria-selected={index===0} aria-controls="works-fan" tabindex={index===0?0:-1} data-work-master-tab={master.id} style={`--tab-bg:var(--${tabTones[index%tabTones.length]});--tab-fg:var(--${tabTones[index%tabTones.length]==='yellow'?'ink':'paper'})`}>{index===0?master.name:master.name.split(' ')[0]}</button>)}
 </div>
 <div class="works-fan" id="works-fan" role="tabpanel" aria-roledescription="карусель" aria-labelledby="works-master-all" aria-describedby="works-instructions" data-work-index="0">
  <p id="works-instructions" class="sr-only">Стрелки влево и вправо выбирают фотографию. Можно выбрать соседний кадр или листать движением мыши.</p>
  {photos.map((photo,index)=>{const offset=workOffset(index,0,photos.length),distance=Math.abs(offset),placeholder=tabTones[index%tabTones.length];return <button class="work-card" data-press-target type="button" data-work-card data-work-id={photo.id} data-work-master-id={photo.masterId} data-work-category={photo.categories.join(' ')} data-work-master={photo.masterName} data-work-caption={photo.caption} hidden={distance>depth} data-work-visible={String(distance<=depth)} data-work-current={String(index===0)} data-work-distance={distance} style={`--work-offset:${offset};--work-distance:${distance};--work-tilt:${workTilt(photo.id)}`} tabindex={index===0?0:-1} aria-current={index===0?'true':undefined} aria-hidden={distance>depth?'true':undefined} aria-label={`Выбрать фото: ${photo.caption}. ${photo.masterName}`} data-feedback="manual"><span class="work-card-surface photo-frame" data-press-surface data-loading-media style={`--work-placeholder:var(--${placeholder});--loading-color:var(--${placeholder==='yellow'?'ink':'paper'})`}><img src={photo.variants[0].url} srcset={photo.variants.map(item=>`${item.url} ${item.width}w`).join(', ')} sizes="(max-width:420px) 80vw, (max-width:960px) 400px, 440px" width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" draggable="false" /></span></button>})}
  <div class="works-empty" data-work-empty hidden role="status"><p>В этой подборке пока нет фотографий.</p><button class="btn" type="button" data-work-reset data-feedback="manual" aria-label="Сбросить фильтры и показать все работы">Все работы</button></div>
 </div>
 <div class="works-caption" aria-live="polite" aria-atomic="true"><div class="works-caption-current"><h3 data-work-caption>{first.caption}</h3><p data-work-author>{first.masterName}</p></div><div class="works-caption-reserve" aria-hidden="true">{captionTitles.map(title=><span class="works-caption-size works-caption-size-title" aria-hidden="true">{title}</span>)}{captionMasters.map(name=><span class="works-caption-size works-caption-size-author" aria-hidden="true">{name}</span>)}</div></div>
 <div class="works-controls" role="group" aria-label="Выбор фотографии работы" data-work-controls data-feedback="manual"><button class="icon-btn" type="button" data-work-step="-1" data-ui-kind="selection" aria-controls="works-fan" aria-label="Предыдущая работа"><Icon name="left" /></button><output data-work-count aria-label={`1 из ${photos.length}`}>1 / {photos.length}</output><button class="icon-btn" type="button" data-work-step="1" data-ui-kind="selection" aria-controls="works-fan" aria-label="Следующая работа"><Icon name="right" /></button></div>
</section>
<script>import '../scripts/works';</script>
