---
import {workPhotos} from '../../content/works-concepts';
interface Props {photo:typeof workPhotos[number];position?:number;}
const {photo,position=0}=Astro.props;
const index=workPhotos.findIndex(item=>item.id===photo.id);
const srcset=photo.variants.map(v=>`${v.url} ${v.width}w`).join(', ');
---
<figure class="wp-photo" data-master-id={photo.masterId}>
 <button class="wp-photo-button" type="button" data-wp-open={index} aria-label={`Увеличить фотографию: ${photo.masterName}`}>
  <img src={photo.src} srcset={srcset} sizes="(max-width:600px) 90vw, (max-width:960px) 45vw, 720px" width={photo.width} height={photo.height} alt={photo.alt} loading={position===0?'eager':'lazy'} decoding="async" />
  <span class="wp-zoom-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg></span>
 </button>
 <figcaption><span>{photo.masterName}</span><span>Фото работы</span></figcaption>
</figure>
