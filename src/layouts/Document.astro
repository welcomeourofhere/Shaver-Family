---
import '../styles/system.css';
import design from '../config/design';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import seo from '../../content/seo.json';
import site from '../../content/site.json';
import {typographyHTML} from '../content/typography-html';
const [opens,closes]=site.hours.split(/\s*[—–-]\s*/);
const business={'@context':'https://schema.org','@type':'HairSalon',name:`Барбершоп ${site.brand}`,url:Astro.site?.href,'@id':Astro.site?`${Astro.site.href}#barbershop`:undefined,description:seo.description,telephone:site.phoneLink,address:{'@type':'PostalAddress',streetAddress:site.address,addressLocality:site.city,addressCountry:'RU'},sameAs:[site.vk],openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens,closes}};
const declarations = (tokens: object) => Object.entries(tokens).map(([key,value])=>`${key}:${value}`).join(';');
const springFallback=Object.entries(design.base).filter(([name,value])=>name.startsWith('--ease-')&&String(value).startsWith('linear(')).map(([name])=>`${name}:var(--ease-out)`).join(';');
const designCSS = `:root{${declarations(design.base)}}` + design.responsive.map(item=>`@media ${item.query}{:root{${declarations(item.tokens)}}}`).join('')+`@supports not (animation-timing-function:linear(0,1)){:root{${springFallback}}}`;
// Resolve shadow aliases on the colored surface so its local tint reaches descendants.
const shadowTokens=Object.fromEntries(Object.entries(design.base).filter(([name])=>name.includes('shadow')&&!['--shadow-base','--shadow-tint'].includes(name)));
const selectionCSS=Object.entries(design.selectionBySurface).map(([tone,colors])=>`[data-selection-surface="${tone}"]{--selection-bg:var(--${colors.background});--selection-fg:var(--${colors.foreground});--shadow-tint:color-mix(in srgb,var(--${tone}) 28%,var(--shadow-base));${declarations(shadowTokens)}}`).join('');
const actionCSS=Object.entries(design.actionBySurface).map(([tone,roles])=>`[data-selection-surface="${tone}"]{--focus-ring:var(--${tone==='yellow'?'ink':'paper'});${tone==='yellow'?'--action-primary-bg:var(--red);--action-primary-fg:var(--paper);':''}${Object.entries(roles).map(([role,color])=>`--action-${role}-hover-bg:var(--${color});--action-${role}-hover-fg:var(--${['yellow','paper'].includes(color)?'ink':'paper'})`).join(';')}}`).join('');
const themeCSS = `[data-theme="dark"]{${declarations(design.dark)}}`;
interface Props {title?:string;description?:string;image?:string;imageAlt?:string;articleData?:Record<string,unknown>;noindex?:boolean;}
const {title=seo.title,description=seo.description,image=seo.image,imageAlt=seo.imageAlt,articleData,noindex=false}=Astro.props;
const canonical=Astro.site?new URL(Astro.url.pathname.replace(/\/$/,'')||'/',Astro.site).href:undefined;
const indexable=Boolean(Astro.site)&&!noindex&&!Astro.url.pathname.startsWith('/previews/');
const socialImage=new URL(image,Astro.site??Astro.url).href;
const articleStructured=articleData?{...articleData,mainEntityOfPage:canonical,image:socialImage,publisher:{'@type':'Organization',name:`Барбершоп ${site.brand}`,url:Astro.site?.href}}:undefined;
const bodyHTML=typographyHTML(await Astro.slots.render('default'));
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={indexable?'index, follow, max-image-preview:large':'noindex, nofollow'} />
    <meta name="theme-color" content={design.base['--surface']} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical&&<link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleData?"article":"website"} />
    <meta property="og:image" content={socialImage} />
    {image===seo.image&&<><meta property="og:image:width" content={String(seo.imageWidth)} /><meta property="og:image:height" content={String(seo.imageHeight)} /><meta property="og:image:type" content={seo.imageType} /></>}
    <meta property="og:image:alt" content={imageAlt} />
    {canonical&&<meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:site_name" content={`Барбершоп ${site.brand}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(business).replaceAll('<','\\u003c')} />
    <style is:inline set:html={designCSS+themeCSS+selectionCSS+actionCSS} />
    {articleStructured && <script type="application/ld+json" set:html={JSON.stringify(articleStructured).replaceAll("<","\\u003c")} />}
    <script is:inline define:vars={{storageKey:design.theme.storageKey}}>
      document.documentElement.classList.add('js');
      let saved='auto';try{saved=localStorage.getItem(storageKey)||'auto';}catch{}
      document.documentElement.dataset.theme=saved==='light'||saved==='dark'?saved:matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
      document.querySelector('meta[name="theme-color"]').setAttribute('content',getComputedStyle(document.documentElement).getPropertyValue('--surface').trim());
    </script>
    <link rel="icon" href="/brand/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/brand/favicon-standard.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/favicon-180.png" sizes="180x180" />
    <link rel="preload" href="/fonts/Manrope-Regular-UI.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Manrope-Medium-UI.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Manrope-SemiBold-UI.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Molot-UI.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body><Fragment set:html={bodyHTML} /><template data-loading-template><LoadingIndicator /></template><script>import '../scripts/loading';import '../scripts/analytics';</script></body>
</html>
