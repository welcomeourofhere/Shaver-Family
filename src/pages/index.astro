---
import SiteFrame from '../layouts/SiteFrame.astro';
import Hero from '../components/Hero.astro';
import ServiceDeck from '../components/ServiceDeck.astro';
import Offers from '../components/Offers.astro';
import Masters from '../components/Masters.astro';
import Works from '../components/Works.astro';
import FirstVisit from '../components/FirstVisit.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Gifts from '../components/Gifts.astro';
import Contacts from '../components/Contacts.astro';
import Reviews from '../components/Reviews.astro';
import '../styles/gifts.css';
---
<SiteFrame>
  <main id="main" tabindex="-1">
    <Hero /><ServiceDeck /><Offers /><Masters /><Works /><FirstVisit />
    <About />
    <Gifts />
    <Reviews />
    <FAQ />
    <Contacts />
  </main>
  <script>import '../scripts/team';</script>
</SiteFrame>
